{
  "name": "CanUniversal",
  "version": "2.0.0",
  "description": "Bibliothèque CAN universelle pour ESP32 : abstraction unifiée du CAN interne (TWAI via ACAN_ESP32) et de un ou plusieurs MCP2515 externes (ACAN2515), avec configuration matérielle externalisée (Provider) et messages typés Chemins de Fer du Chablais (CFC).",
  "keywords": [
    "can",
    "can-bus",
    "esp32",
    "twai",
    "mcp2515",
    "multi-bus",
    "dcc",
    "model-railroad",
    "discovery-2026"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/prune74/CanUniversal.git"
  },
  "authors": [
    {
      "name": "Bruno Rivera",
      "url": "https://github.com/prune74",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/prune74/CanUniversal",
  "frameworks": [
    "arduino"
  ],
  "platforms": [
    "espressif32"
  ],
  "headers": [
    "CanUniversal.h"
  ],
  "build": {
    "includeDir": "src"
  },
  "export": {
    "include": [
      "src",
      "examples",
      "README.md",
      "LICENSE",
      "library.json",
      "library.properties",
      "keywords.txt"
    ]
  },
  "dependencies": {
    "pierremolinaro/ACAN_ESP32": "^1.0.6",
    "pierremolinaro/ACAN2515": "^2.0.3"
  }
}